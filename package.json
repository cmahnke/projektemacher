  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "echarts-stat": "^1.2.0",
    "fuse.js": "^7.5.0",
    "jquery": "^4.0.0",
    "popper.js": "^1.16.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@eslint/eslintrc": "~3.3.7",
    "@eslint/js": "~10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/howler": "^2.2.13",
    "@types/js-cookie": "^3.0.6",
    "@types/pdfobject": "^2.2.5",
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.0",
    "cesium": "1.144.0",
    "cors": "^2.8.6",
    "doiuse": "^6.0.6",
    "eslint": "~10.12.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-toml": "1.5.0",
    "express": "^5.1.0",
    "globals": "^17.13.0",
    "gltf-pipeline": "^4.3.1",
    "jsonc-eslint-parser": "^3.3.0",
    "lighthouse": "^13.5.0",
    "markdownlint-cli": "~0.49.1",
    "mktemp": "~1.0.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "obj2gltf": "^3.2.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "postcss-discard-duplicates": "^9.0.7",
    "postcss-import": "^17.0.1",
    "postcss-inline-svg": "^6.0.0",
    "postcss-utilities": "^0.8.4",
    "prettier": "^3.9.10",
    "puppeteer": "^25.14.0",
    "purgecss": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0",
    "svgo": "^4.1.0",
    "toml": "^5.0.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "xslt3": "^2.7.0",
    "@types/jquery": "^4.0.1",
    "fast-glob": "^3.3.3"
  },
  "scripts": {
    "lint-scss": "stylelint 'assets/scss/*'",
    "lint-js": "eslint 'assets/js' 'assets/ts'",
    "lint-toml": "eslint i18n",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint-scss && npm run lint-js && npm run lint-toml",
    "check-generated-css": "stylelint --config ./themes/projektemacher-base/.stylelintrc-postbuild.yaml 'docs/css/*.css'",
    "postbuild-lint": "npm run check-generated-css",
    "check:a11y": "node themes/projektemacher-base/scripts/check-a11y.mjs",
    "check:lighthouse": "node themes/projektemacher-base/scripts/check-lighthouse.mjs",
    "validate-iiif-gnu": "find docs -name manifest.json -print0 | xargs -r -0 -n1 npx eslint -c themes/projektemacher-base/eslint.config.mjs",
    "validate-gjson-gnu": "find docs -name '*.gjson' -o -name '*.geojson' -print0 | xargs -r -0 -n1 npx eslint -c themes/projektemacher-base/eslint.config.mjs",
    "validate-iiif-bsd": "find docs -name manifest.json -print0 | xargs -0 -n1 npx eslint -c themes/projektemacher-base/eslint.config.mjs",
    "validate-gjson-bsd": "find docs -name '*.gjson' -o -name '*.geojson' -print0 | xargs -0 -n1 npx eslint -c themes/projektemacher-base/eslint.config.mjs",
    "validate-iiif": "case $OSTYPE in darwin*) npm run validate-iiif-bsd ;; linux*) npm run validate-iiif-gnu ;; bsd*) npm run validate-iiif-bsd ;; *)  exit 100 ;; esac",
    "validate-gjson": "case $OSTYPE in darwin*) npm run validate-gjson-bsd ;; linux*) npm run validate-gjson-gnu ;; bsd*) npm run validate-gjson-bsd ;; *)  exit 100 ;; esac",
    "validate": "npm run validate-iiif && npm run validate-gjson",
    "build": "hugo",
    "start": "hugo server -D --debug --disableFastRender --buildFuture",
    "svgo": "svgo -i Source\\ Files/Logo/Laborant.svg -o static/images/laborant.svg"
  },
  "overrides": {
    "canvas": "npm:dry-uninstall"
  },
  "resolutions": {
    "canvas": "npm:empty-npm-package"
  }
}
