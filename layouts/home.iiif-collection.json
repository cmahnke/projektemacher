{{- $manifest := "collection.json" -}}
{{- $pages := where site.Pages "Kind" "section" -}}

{{- $iiif := slice -}}
{{- $seen := slice -}}
{{- range $pages -}}
  {{- $page := . -}}
  {{- $hasCollection := false -}}
  {{- range .OutputFormats -}}
    {{- if eq .Name "iiif-collection" -}}
      {{- $hasCollection = true -}}
      {{- break -}}
    {{- end -}}
  {{- end -}}
  {{- if not $hasCollection -}}
    {{- continue -}}
  {{- end -}}
  {{- $dir := split (strings.Substr (string $page.Path) 1) "/" -}}
  {{- if lt (len $dir) 2 -}}
    {{- continue -}}
  {{- end -}}
  {{- $prefix := index $dir 1 -}}
  {{- if in $seen $prefix -}}
    {{- continue -}}
  {{- end -}}
  {{- $seen = $seen | append $prefix -}}
  {{- $iiif = $iiif | append $page -}}
{{- end -}}
{
  "@context": "http://iiif.io/api/presentation/3/context.json",
  "id": "{{ site.BaseURL }}collection.json",
  "type": "Collection",
  "label": {
      "{{ site.Language.Name }}": [
        "{{ site.Title }}"
      ]
    {{- if hugo.IsMultilingual -}}
      {{- $translations := where site.Home.AllTranslations ".Lang" "!=" site.Language.Name -}}
      {{- range $translations -}}
      ,
        "{{ .Lang }}": [
          "{{ .Name }}"
        ]
      {{ end }}
    {{- end -}}
  },
  "items": [
    {{- range $i, $item := $iiif -}}
      {
        {{- $dir := strings.Substr (string $item.Path) 1 -}}
        {{- $dir = split (string $dir) "/" -}}
        {{- $displayName := "" -}}
        {{- $linkPrefix := "" -}}
        {{- $prefix := index $dir 1 -}}
        {{- $sectionHeading := printf "/%s" (delimit (slice "blog" $prefix) "/") -}}
        {{- $blogPage := site.GetPage $sectionHeading -}}
        {{- if eq (printf "%T" $blogPage) "*page.nopPage" -}}
            {{- $blogPage = site.GetPage "/blog/projektemacher/index.md" -}}
            {{- $sectionHeading = "" -}}
            {{- $prefix = "projektemacher" -}}
        {{- end -}}

        {{- $displayName = $blogPage.Title -}}
        {{- if ($blogPage.Param "linkPrefix") -}}
          {{ $linkPrefix = $blogPage.Param "linkPrefix" -}}
        {{- else -}}
          {{ $linkPrefix = $blogPage.Param "link" -}}
        {{- end -}}

        "id": "{{ printf "%s%s" $linkPrefix $manifest }}",
        "type": "Collection",
        "label": {
          "none": [
            {{ $displayName | jsonify }}
          ]
        }
      }
      {{- if ne $i (sub (len $iiif) 1) -}}
       ,
      {{- end -}}
    {{- end -}}
  ]
}
